# ==============================================================================
# MinBook Environment Configuration (.env.example)
# Quantitative NY Open Futures Decision Engine for CME Nasdaq-100 (NQ/MNQ)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLOUD & AUTH (Free Tier Postgres, Auth & Storage)
# ------------------------------------------------------------------------------
# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Modern Publishable API Key (format: sb_publishable_...) or Legacy Anon Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 2. CORE CONFIGURATION (Zero-Config / Free Out-of-the-Box)
# ------------------------------------------------------------------------------
# Market Data Provider: 'yahoo' (default, free, no API key required), 'polygon', or 'fallback'
MARKET_DATA_PROVIDER=yahoo

# Server-Side Cache TTL in Seconds (prevents provider rate limiting during active sessions)
# Default: 60 seconds
CACHE_TTL_SECONDS=60

# Local SQLite Database Path
# Default: ./data/minbook.db
DATABASE_PATH=./data/minbook.db

# ------------------------------------------------------------------------------
# 2. OPTIONAL: FREE GEMINI AI (STRAT CHAT & JOURNAL VISION)
# ------------------------------------------------------------------------------
# Google Gemini API Key (server-only, never prefix with NEXT_PUBLIC_)
# Powers /chat (Gemini 2.5 Flash vision & streaming) and /journal screenshot parsing.
# Users can also save their own key securely on-site in /chat (AES-256-GCM encrypted).
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional 32-byte hex secret used to AES-256-GCM encrypt user-saved API keys in Supabase
MINBOOK_KEY_SECRET=

# ------------------------------------------------------------------------------
# 3. OPTIONAL: ALTERNATIVE MARKET DATA PROVIDERS
# ------------------------------------------------------------------------------
# Polygon.io API key for live/delayed market data feeds
# Get a key at: https://polygon.io
POLYGON_API_KEY=

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTOMATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Secret token to protect automated execution of /api/cron/snapshot-and-grade
# Compatible with Vercel Cron Bearer tokens or external cron job runners.
CRON_SECRET=

