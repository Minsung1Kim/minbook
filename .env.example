# OpenPulse Market Data Configuration
# -------------------------------------------------------------
# Choose default market data provider: 'yahoo' (default, free, no key required), 'polygon', or 'fallback'
MARKET_DATA_PROVIDER=yahoo

# (Optional) Polygon.io API key for live/delayed market data feeds
# Get a free or starter key at https://polygon.io
POLYGON_API_KEY=

# (Optional) Alpha Vantage API key
# Get a free key at https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=

# (Optional) Finnhub API key
# Get a free key at https://finnhub.io
FINNHUB_API_KEY=

# Server-side market data cache TTL in seconds (prevents rate limit burning)
# Default: 60 seconds during active market hours
CACHE_TTL_SECONDS=60

# Database file path (defaults to ./data/openpulse.db)
DATABASE_PATH=./data/openpulse.db
