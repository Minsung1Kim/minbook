# ==============================================================================
# MinBook Environment Configuration (.env.example)
# Quantitative NY Open Futures Decision Engine for CME Nasdaq-100 (NQ/MNQ)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE CONFIGURATION (Zero-Config / Free Out-of-the-Box)
# ------------------------------------------------------------------------------
# Market Data Provider: 'yahoo' (default, free, no API key required), 'polygon', or 'fallback'
MARKET_DATA_PROVIDER=yahoo

# Server-Side Cache TTL in Seconds (prevents provider rate limiting during active sessions)
# Default: 60 seconds
CACHE_TTL_SECONDS=60

# Local SQLite Database Path
# Default: ./data/minbook.db
DATABASE_PATH=./data/minbook.db

# ------------------------------------------------------------------------------
# 2. OPTIONAL: AI JOURNAL VISION & MULTIMODAL PARSING
# ------------------------------------------------------------------------------
# Google Gemini API Key for automated trade screenshot parsing in /journal
# If left blank, the app runs completely normally with manual trade entry and full analytics.
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. OPTIONAL: ALTERNATIVE MARKET DATA PROVIDERS
# ------------------------------------------------------------------------------
# Polygon.io API key for live/delayed market data feeds
# Get a key at: https://polygon.io
POLYGON_API_KEY=

# Alpha Vantage API key
# Get a free key at: https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=

# Finnhub API key
# Get a free key at: https://finnhub.io
FINNHUB_API_KEY=
